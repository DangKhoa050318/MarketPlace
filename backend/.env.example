# PostgreSQL Database Configuration
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5433

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest

# MailHog Configuration
MAIL_HOST=localhost
MAIL_PORT=1025

# JWT Configuration — REQUIRED, no default in the app.
# Generate a UNIQUE 256-bit (>=32 byte) secret per environment, e.g.:  openssl rand -base64 48
# Never reuse this across environments or commit a real secret.
JWT_SECRET=CHANGE_ME_generate_a_unique_base64_secret

# Refresh token is sent only as an HttpOnly cookie. Keep false for the local HTTP demo;
# production HTTPS deployments must set this to true.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_MAX_AGE=7d

# Payment is fail-closed by default. Set this only after installing/configuring a real provider adapter.
PAYMENT_PROVIDER=disabled

# Rule-based recommendations
RECOMMENDATION_BEST_SELLER_LOOKBACK=30d
RECOMMENDATION_VALID_ORDER_STATUSES=CONFIRMED,PROCESSING,SHIPPED,DELIVERED
RECOMMENDATION_CO_VIEWED_LOOKBACK=90d
RECOMMENDATION_MIN_CO_VIEWED_OCCURRENCES=2
RECOMMENDATION_CO_PURCHASED_LOOKBACK=90d
RECOMMENDATION_MIN_CO_PURCHASED_OCCURRENCES=2
RECOMMENDATION_SIMILAR_CANDIDATE_POOL_SIZE=500
RECOMMENDATION_SIMILAR_PRECOMPUTE_SIZE=50

# Core feature flags
FEATURE_REVIEW_QA_ENABLED=true
FEATURE_PROMOTIONS_ENABLED=true
FEATURE_RECOMMENDATIONS_ENABLED=true
FEATURE_JOURNEY_ANALYTICS_ENABLED=true
FEATURE_CHAT_ASSISTANT_ENABLED=true

# Shopping chat assistant. Keep the real key out of source control.
CHAT_AI_ENABLED=true
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CONNECT_TIMEOUT=3s
GEMINI_READ_TIMEOUT=8s
CHAT_CONVERSATION_TTL=24h
CHAT_MAX_PRODUCTS=6
CHAT_MAX_HISTORY_MESSAGES=12

# Analytics query cache freshness
ANALYTICS_CACHE_TTL=5m

# Application & CORS URL Configuration
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# PayGate Gateway Dynamic URL Configuration
PAYGATE_API_URL=http://localhost:8081
PAYGATE_CHECKOUT_URL=http://localhost:4201/checkout
PAYGATE_API_KEY=mock-merchant-api-key-123456
PAYGATE_RETURN_URL=http://localhost:4200/orders/callback
PAYGATE_CANCEL_URL=http://localhost:4200/cart
